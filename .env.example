# ── Chatbot Engine ────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=86400                          # 24 hours in seconds

# Internal Docker service URLs (use service names from docker-compose)
NLP_SERVICE_URL=http://nlp-service:8001
ASR_SERVICE_URL=http://asr-service:8002
SENTIMENT_SERVICE_URL=http://sentiment-service:8003
ADAPTIVE_SERVICE_URL=http://adaptive-engine:8004
REPORT_SERVICE_URL=http://report-service:8005

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://interview_user:password@postgres:5432/interview_db
# asyncpg URL for Python async services (same creds, different scheme)
ASYNC_DATABASE_URL=postgresql+asyncpg://interview_user:password@postgres:5432/interview_db
REDIS_URL=redis://redis:6379/0

# ── ML Models ─────────────────────────────────────────────────────────
# Paths inside containers (mounted from ./models via docker-compose volume)
BERT_MODEL_PATH=/models/bert_scorer.pt
LSTM_MODEL_PATH=/models/confidence_lstm.pt
GLOVE_PATH=/models/glove.6B.100d.txt

# Whisper model size: base (74M) | small (244M) | medium (769M)
# Use 'small' for best speed/accuracy tradeoff on CPU
WHISPER_MODEL_SIZE=small

# ── AWS S3 (audio uploads + PDF reports) ─────────────────────────────
# Leave blank to use local filesystem fallback in development
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=interview-bot-reports
S3_REGION=ap-south-1

# ── App Config ────────────────────────────────────────────────────────
# Frontend origin for CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
MAX_AUDIO_MB=10

# ── Local dev overrides ───────────────────────────────────────────────
# When running services directly (not via Docker), point to localhost
# NLP_SERVICE_URL=http://localhost:8001
# DATABASE_URL=postgresql://interview_user:password@localhost:5432/interview_db
# REDIS_URL=redis://localhost:6379/0
